# Supabase → Project Settings → API (ou Connect)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Importar treino por texto (IA). Só no servidor: nunca use NEXT_PUBLIC_ aqui.
# platform.openai.com → API keys
OPENAI_API_KEY=<openai-api-key>
# Opcionais: provedor e modelo (padrão gpt-6-luna)
# AI_PROVIDER=openai          # "mock" usa a resposta gravada em lib/ai/fixtures (testes; não chama API)
# AI_MODEL=gpt-6-luna
# Raciocínio do modelo: none (padrão, mais rápido), low, medium, high ou off (omite)
# AI_REASONING_EFFORT=none
# Leituras de treino por usuário por dia (1 a 100, padrão 10)
# AI_DAILY_LIMIT=10
